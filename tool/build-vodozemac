#!/bin/sh
# Builds vodozemac's native library for the encryption tests, without
# building the app around it. Run after `flutter pub get`, from the repo
# root; the tests find the result in build/vodozemac/. On Windows, run it
# in Git Bash.
set -eu

package=$(sed -n 's|.*"rootUri": "file://\(.*flutter_vodozemac[^"]*\)".*|\1|p' \
  .dart_tool/package_config.json | head -n 1)
[ -n "$package" ] || { echo "run flutter pub get first" >&2; exit 1; }

# A Windows file URI keeps a slash before the drive: /C:/Users/...
case "$package" in /?:/*) package=${package#/} ;; esac

# What cargo names the library, and what vodozemac looks for: on macOS it
# loads the name the Flutter plugin gives it.
case "$(uname -s)" in
  Darwin) built=libvodozemac_bindings_dart.dylib; wanted=libflutter_vodozemac.dylib ;;
  MINGW* | MSYS* | CYGWIN*) built=vodozemac_bindings_dart.dll; wanted=$built ;;
  *) built=libvodozemac_bindings_dart.so; wanted=$built ;;
esac

CARGO_TARGET_DIR=build/vodozemac/target \
  cargo build --release --lib --manifest-path "$package/rust/Cargo.toml"
cp "build/vodozemac/target/release/$built" "build/vodozemac/$wanted"
